{
  "name": "aladdin-wallet",
  "version": "0.6.2",
  "private": true,
  "description": "General-purpose EIP-7702 Chrome extension wallet (MV3) — exposes wallet_signAuthorization and eth_sendTransaction({authorizationList}) with no delegate whitelist.",
  "license": "MIT",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "watch": "bun run scripts/build.ts --watch",
    "pack": "bun run scripts/pack.ts",
    "test": "bun test tests/",
    "test:e2e": "bun run build && bunx playwright test",
    "audit": "bun audit --audit-level=moderate",
    "typecheck": "bunx tsc --noEmit",
    "verify": "bun run audit && bun run typecheck && bun run test && bun run build",
    "clean": "rm -rf dist *.zip"
  },
  "dependencies": {
    "@scure/bip39": "^2.2.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.50.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@types/bun": "^1.3.13",
    "@types/chrome": "^0.0.270",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ipfs-unixfs-importer": "^16.1.5",
    "multiformats": "^14.0.0",
    "solc": "^0.8.35",
    "typescript": "^5"
  },
  "overrides": {
    "playwright-core": "1.60.0",
    "ws": "^8.21.0",
    "tmp": "^0.2.4"
  }
}
